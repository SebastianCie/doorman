# Kopieren nach deploy/.env und ausfüllen. deploy/.env wird NICHT eingecheckt.

# Neon-Verbindung genau so, wie Neon sie anzeigt (postgresql://user:passwort@host/db?sslmode=require...)
DATABASE_URL=postgresql://neondb_owner:PASSWORT@ep-xxxx-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Passwort für "admin" beim allerersten Start (nur relevant, solange die DB noch keine Benutzer hat)
INITIAL_ADMIN_PASSWORD=bitte-aendern

# Wird beim ersten Lauf automatisch erzeugt und hier gespeichert. Gleich lassen, sonst müssen sich alle neu anmelden.
SESSION_ENCRYPTION_KEY=

# Optional
# IMAGE=ghcr.io/sebastiancie/doorman:latest
